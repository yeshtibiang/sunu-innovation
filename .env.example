# Serveur SMTP utilisé pour envoyer les formulaires (contact + devis).
# Copiez ce fichier en .env.local et renseignez les valeurs réelles.
SMTP_HOST=
SMTP_PORT=587
# true uniquement pour le port 465 (SSL implicite). STARTTLS sinon.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Destinataire des demandes.
CONTACT_TO=contact@sunuinnovation.com
# Doit correspondre à la boîte authentifiée ci-dessus (SPF/DMARC).
CONTACT_FROM=Site Sunu Innovation <contact@sunuinnovation.com>

# À renseigner uniquement si l'envoi échoue avec une erreur TLS du type
# "Hostname/IP does not match certificate's altnames" (fréquent sur
# l'hébergement mutualisé, ex. LWS avec un certificat *.lwspanel.com).
# Mettre le nom porté par le certificat présenté (indiqué dans le message
# d'erreur), pas le nom de votre domaine.
SMTP_TLS_SERVERNAME=
